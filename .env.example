# ========================
# Evolution API - Environment Variables for Render
# ========================

# Server
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
# IMPORTANT: After deploy, set this to your Render URL
# Example: https://evolution-api-xxxx.onrender.com
SERVER_URL=https://your-service-name.onrender.com

# Authentication - Change this to a strong random key!
AUTHENTICATION_API_KEY=change-me-to-a-very-secure-random-string

# Database (Render will inject DATABASE_CONNECTION_URI automatically if using Blueprint)
DATABASE_PROVIDER=postgresql
# DATABASE_CONNECTION_URI=postgresql://user:pass@host:5432/evolution?schema=public

# Cache - Redis
CACHE_REDIS_ENABLED=true
# CACHE_REDIS_URI=redis://... (Render Key Value connection string)
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# Instance settings
DEL_INSTANCE=false

# Phone session name shown on WhatsApp
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome

# QR Code
QRCODE_LIMIT=30
QRCODE_COLOR=#175197

# Logs
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=true
LOG_BAILEYS=error

# CORS
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# Webhook (optional - set later if needed)
WEBHOOK_GLOBAL_ENABLED=false
# WEBHOOK_GLOBAL_URL=

# Telemetry (optional)
TELEMETRY_ENABLED=false
